{
  "name": "zarslanstudio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run",

    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",

    "auth:schema": "auth generate --config src/lib/auth/index.ts --output src/lib/server/db/auth.schema.ts --yes",

    "d1:migrate:local": "wrangler d1 migrations apply zarslanstudio-db-dev --local",
    "d1:migrate:remote": "wrangler d1 migrations apply zarslanstudio-db-dev --remote",
    "d1:migrationlist:local": "wrangler d1 migrations list zarslanstudio-db-dev --local",
    "d1:migrationlist:remote": "wrangler d1 migrations list zarslanstudio-db-dev --remote",
    "d1:reset:local": "wrangler d1 execute zarslanstudio-db-dev --local --file=./resetdb-dev.sql",
    "d1:reset:remote": "wrangler d1 execute zarslanstudio-db-dev --remote --file=./resetdb-dev.sql",
    
    "gen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.27",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@libsql/client": "^0.18.0",
    "@lucide/svelte": "^1.79.0",
    "@tabler/icons-svelte": "^3.52.0",
    "better-auth": "^1.7.27",
    "bits-ui": "^2.22.0",
    "cn": "^0.5.2",
    "drizzle-orm": "^1.0.0-rc.6",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "1.0.0-next.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.8",
    "auth": "^1.7.27",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "drizzle-kit": "^1.0.0-rc.6",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1",
    "wrangler": "^4.167.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
